---
import Layout from '../layouts/Layout.astro';
import { berichte } from '../data/berichte';
---

<Layout title="Berichte">
  <section class="page-hero">
    <div class="container">
      <h1>Berichte</h1>
      <!-- <div class="eyebrow">Berichte</div> -->
      <!-- <h1>In den Medien</h1> -->
    </div>
  </section>

  <section>
    <div class="container">
      {berichte.map((bericht) => (
        <div class="bericht">
          <h3>{bericht.title}</h3>
          <img src={bericht.image} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .bericht {
    margin-bottom: 25px;
  }
</style>
