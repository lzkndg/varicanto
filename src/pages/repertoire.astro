---
import Layout from '../layouts/Layout.astro';
import { tracks } from '../data/tracks';
import { videos } from '../data/videos';
---

<Layout title="Musik">
  <section class="page-hero">
    <div class="container">
      <h1>Repertoire</h1>
      <p class="lead">
        Wie unser Name <em>Varicanto</em> (variare: verändern, cantare: singen) sagt, singen wir Lieder verschiedener Musikarten und Sprachen. 
      </p>
      <p>
        Hier einige Beispiele aus unserem umfangreichen Repertoire:
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="track-list">
        {videos.map((video) => (
          <li class="track">{video.title}<br />
            <iframe width="560" height="315"
              src={video.url}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="track-list">
        {tracks.map((track) => (
          <li class="track">
            <p class="track-title">{track.title}</p>
            <audio controls preload="none" src={`/audio/${track.file}`}></audio>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .lead {
    max-width: 55ch;
    opacity: 0.85;
  }

  .track-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .track {
    background: var(--cream);
    border: 1px solid var(--sand-deep);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
  }

  .track-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.9em;
  }

  .track audio {
    width: 100%;
  }
</style>
