---
import Layout from '../layouts/Layout.astro';
import { tracks } from '../data/tracks';
import { videos } from '../data/videos';
---

<Layout title="Musik">
  <section class="page-hero">
    <div class="container">
      <h1>Repertoire</h1>
      <p class="lead">
        Wie unser Name <em>Varicanto</em> (variare: verändern, cantare: singen) sagt, singen wir Lieder verschiedener Musikarten und Sprachen. 
      </p>
      <p>
        Hier einige Beispiele aus unserem umfangreichen Repertoire:
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="track-list">
        {videos.map((video) => (
          <li class="track">{video.title}<br />
            <iframe width="560" height="315"
              src={video.url}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="track-list">
        {tracks.map((track) => (
          <li class="track">
            <p class="track-title">{track.title}</p>
            <audio controls preload="none" src={`/audio/${track.file}`}></audio>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section>
    <div class="container">
      <h3>Evergreens</h3>
      <ul>
        <li>Fields of Gold</li>
        <li>Rosanna</li>
        <li>Frag den Abendwind</li>
        <li>Tears in Heaven</li>
        <li>Musical - Medley</li>
        <li>I have a dream</li>
        <li>Über sieben Brücken</li>
        <li>Chattanooga Choo Choo</li>
        <li>usw.</li>
      </ul>

      <h3>Gospel und Spirituals</h3>
      <ul>
        <li>Jesus On The Main Line</li>
        <li>Lean On Me</li>
        <li>This Little Light Of Mine</li>
        <li>Oh Happy Day</li>
        <li>Rivers Of Babylon</li>
        <li>Hallelujah - I'm Born To Live again</li>
        <li>Somebody's Knocking At Your Door</li>
        <li>Oh When The Saints Go Marching In</li>
        <li>Resurrection Power</li>
        <li>usw.</li>
      </ul>

      <h3>Advents- und Weihnachtslieder</h3>
      <ul>
        <li>Leise rieselt der Schnee</li>
        <li>Jingle Bells</li>
        <li>Aba Heidschi bumbeidschi</li>
        <li>Noel</li>
        <li>Still, weil's Kindlein schlafen will</li>
        <li>Hark The Herald Angels Sing</li>
        <li>Es wird scho glei' dumpa</li>
        <li>Amezaliwa</li>
        <li>Hajdmo braco sada</li>
        <li>Es ist ein Ros entsprungen</li>
        <li>Il est né</li>
        <li>Freu dich, Erd und Sternenzelt</li>
        <li>Maria durch ein Dornwald ging</li>
        <li>Rudolph the Red-nosed Reindeer</li>
        <li>Africal Noel</li>
        <li>usw.</li>
      </ul>

      <h3>Volkslieder</h3>
      <ul>
        <li>Vecchia Roma</li>
        <li>Sierra Madre</li>
        <li>Auld Lang Syne</li>
        <li>Bergvagabunden</li>
        <li>Zar je voljeti grijeh</li>
        <li>Amore mio non piangere</li>
        <li>Country Roads</li>
        <li>Der Bajazzo - Warum bist du gekommen</li>
        <li>Wahre Freundschaft soll nicht wanken</li>
        <li>Vieni sulla barchetta</li>
        <li>Ame schöne Morge</li>
        <li>Steirische Harmonika Messe (Florian Michlbauer)</li>
        <li>usw.</li>
      </ul>

      <h3>Klassisch</h3>
      <ul>
        <li>Ave verum (Wolfgang Amadeus Mozart)</li>
        <li>G-Dur Messe (Franz Schubert)</li>
        <li>Canticorum jubilo (Georg Friedrich Händel)</li>
        <li>Da pacem domine (Melchior Franck)</li>
        <li>Ubi Caritas</li>
        <li>usw.</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .lead {
    max-width: 55ch;
    opacity: 0.85;
  }

  .track-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .track {
    background: var(--cream);
    border: 1px solid var(--sand-deep);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
  }

  .track-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.9em;
  }

  .track audio {
    width: 100%;
  }
</style>
