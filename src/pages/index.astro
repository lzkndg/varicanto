---
import Layout from '../layouts/Layout.astro';
import { upcomingEvents } from '../data/events';
import { tracks } from '../data/tracks';
import { sortedNews, formatNewsDate } from '../data/news';

const teaserEvents = upcomingEvents.slice(0, 3);
const teaserTrack = tracks[0];
const teaserNews = sortedNews().slice(0, 4);
---

<Layout title="Start">
  <!-- <section>
    <div class="container">
      <img class="title-image" src="/images/logo-singing-quer-beet.png" alt="Varicanto - singing quer beet" />

    </div>
  </section> -->
  <section class="hero section-tint">
    <div class="container hero-inner">
      <div class=""><h1>Herzlich Willkommen!</h1></div>
      <img class="hero-image" src="/images/willkommen.jpg" alt="Willkommen bei Varicanto" />
    </div>
  </section>

  {teaserNews.length > 0 && (
    <section class="news-teaser">
      <div class="container">
        <h2>Neuigkeiten</h2>
        <div class="news-teaser-grid">
          {teaserNews.map((item) => (
            <a class="news-card" href="/neuigkeiten/">
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
              <div class="news-card-body">
                <p class="news-card-date">{formatNewsDate(item.date)}</p>
                <p class="news-card-title">{item.title}</p>
                <p class="news-card-text">{item.text}</p>
              </div>
            </a>
          ))}
        </div>
        <a class="btn" href="/neuigkeiten/">Alle Neuigkeiten ansehen</a>
      </div>
    </section>
  )}

  <section class="intro">
    <div class="container intro-grid">
      <div>
        <h2>Neue Mitglieder</h2>
      <p>
        Bist du interessiert, bei uns mitzusingen? Wir freuen uns über neue Stimmen –
        melde dich unter <a href="mailto:info@varicanto.li">info@varicanto.li</a>.
      </p>
        <p>Melden Sie sich bei uns → <a href="mailto:info@varicanto.li">info@varicanto.li</a></p>
      </div>
      <div class="listen-card">
        <p class="eyebrow">Jetzt reinhören</p>
        <p class="listen-title">{teaserTrack.title}</p>
        <audio controls preload="none" src={`/audio/${teaserTrack.file}`}></audio>
      </div>
    </div>
  </section>

  <section class="section-tint events-teaser">
    <div class="container">
      <h2>Nächste Auftritte</h2>
      {teaserEvents.length > 0 ? (
        <ol class="event-list">
          {teaserEvents.map((event) => (
            <li>
              <span class="event-date">{event.date}</span>
              <span class="event-title">{event.title}</span>
              <span class="event-place">{event.place}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">
          Aktuell sind keine Auftritte öffentlich gelistet – schaut bald wieder vorbei.
        </p>
      )}
      <a class="btn" href="/auftritte/">Alle Auftritte ansehen</a>
    </div>
  </section>
</Layout>

<style>

  .hero {
    padding-block: 6rem 5rem;
  }

  .hero-inner {
    grid-template-columns: 1fr;
    /* grid-template-columns: 1.1fr 1fr; */
    align-items: center;
    gap: 3rem;
    display: grid;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }

  .hero h1 {
    font-size: clamp(2rem, 8vw, 3rem);
    /* font-style: italic; */
    line-height: 0.95;
    margin-block: 0.2em 0.6em;
  }

  .hero-lead {
    font-size: 1.1rem;
    max-width: 46ch;
  }

  .hero-lead em {
    color: var(--wine);
    font-style: italic;
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    display: flex;
  }

  .intro-grid {
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 3rem;
    display: grid;
  }

  .intro-grid a {
    color: var(--wine);
    font-weight: 500;
    text-decoration: none;
  }

  .intro-grid a:hover {
    text-decoration: underline;
  }

  .listen-card {
    background: var(--cream);
    border: 1px solid var(--sand-deep);
    border-radius: 4px;
    padding: 1.75rem;
  }

  .listen-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0.3em 0 1em;
  }

  .listen-card audio {
    width: 100%;
  }

  .events-teaser h2 {
    margin-bottom: 2rem;
  }

  .empty-state {
    opacity: 0.75;
    margin-bottom: 2.5rem;
  }

  .event-list {
    border-top: 1px solid #241d2b26;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  .event-list li {
    border-bottom: 1px solid #241d2b26;
    grid-template-columns: 140px 1fr auto;
    gap: 1rem;
    padding: 1.1rem 0;
    display: grid;
  }

  .event-date {
    font-family: var(--font-body);
    color: var(--wine);
    font-size: 0.85rem;
  }

  .event-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .event-place {
    color: var(--plum);
    opacity: 0.9;
  }

  .news-teaser h2 {
    margin-bottom: 2rem;
  }

  .news-teaser-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
    display: grid;
  }

  .news-card {
    color: var(--ink);
    text-decoration: none;
    display: block;
  }

  .news-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .news-card-date {
    font-family: var(--font-mono);
    color: var(--wine);
    font-size: 0.8rem;
    margin: 0 0 0.3em;
  }

  .news-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0 0 0.3em;
  }

  .news-card-text {
    margin: 0;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (width <= 780px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-image {
      order: -1;
    }
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .event-list li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .news-teaser-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
