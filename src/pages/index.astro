---
import Layout from '../layouts/Layout.astro';
import { upcomingEvents } from '../data/events';
import { tracks } from '../data/tracks';
import { sortedNews, formatNewsDate } from '../data/news';

const teaserEvents = upcomingEvents.slice(0, 3);
const teaserTrack = tracks[3];
// const teaserNews = sortedNews().slice(0, 4);
const items = sortedNews();
---

<Layout title="Start">
  <!-- <section>
    <div class="container">
      <img class="title-image" src="/images/logo-singing-quer-beet.png" alt="Varicanto - singing quer beet" />

    </div>
  </section> -->
  <section class="hero">
    <div class="container hero-inner">
      <div class=""><h1>Herzlich Willkommen!</h1></div>
      <img class="hero-image" src="/images/willkommen.jpg" alt="Willkommen bei Varicanto" />
    </div>
  </section>

    <section>
    <div class="container">
      <div><h1>Neuigkeiten</h1></div>
      <div class="flyer">
        <img src="/images/flyer_projektsingen_2026.png" alt="Unterstütze uns im Projektsingen, Konzert im Vaduzersaal am 24. April 2027">
      </div>

      {items.length > 0 ? (
        <ul class="news-list">
          {items.map((item) => (
            <li class="news-item">
              <div>
                <img src={item.image} alt={item.imageAlt} loading="lazy" />

              </div>
              <div class="news-body">
                <p class="news-date">{formatNewsDate(item.date)}</p>
                <h3 class="news-title">{item.title}</h3>
                <p class="news-text">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Aktuell gibt es keine Neuigkeiten.</p>
      )}
    </div>
  </section>

  <section class="intro section-tint">
    <div class="container intro-grid">
      <div>
        <h2>Neue Mitglieder</h2>
        <p>
          Bist du interessiert, bei uns mitzusingen? Wir freuen uns über neue Stimmen –
          melde dich unter <a href="mailto:info@varicanto.li">info@varicanto.li</a>.
        </p>
      </div>
      <div class="listen-card">
        <p class="eyebrow">Jetzt reinhören</p>
        <p class="listen-title">{teaserTrack.title}</p>
        <audio controls preload="none" src={`/audio/${teaserTrack.file}`}></audio>
      </div>
    </div>
  </section>

  <section class="events-teaser">
    <div class="container">
      <h2>Nächste Auftritte</h2>
      {teaserEvents.length > 0 ? (
        <ol class="event-list">
          {teaserEvents.map((event) => (
            <li>
              <span class="event-date">{event.date}</span>
              <span class="event-title">{event.title}</span>
              <span class="event-place">{event.place}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">
          Aktuell sind keine Auftritte öffentlich gelistet – schaut bald wieder vorbei.
        </p>
      )}
      <a class="btn" href="/termine/">Alle Auftritte ansehen</a>
    </div>
  </section>
</Layout>

<style>

  .flyer {
    padding: 0 0 2rem 0;
  }

  .hero {
    padding-block: 15rem 5rem;
  }

  .hero-inner {
    grid-template-columns: 1fr;
    /* grid-template-columns: 1.1fr 1fr; */
    /* align-items: center; */
    /* gap: 5rem; */
    /* display: grid; */
  }

  .hero-image {
    /* max-width: 80%; */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }

  .hero h1 {
    font-size: clamp(2rem, 8vw, 3rem);
    /* font-style: italic; */
    line-height: 0.95;
    margin-block: 0.2em 0.6em;
  }

  .hero-lead {
    font-size: 1.1rem;
    max-width: 46ch;
  }

  .hero-lead em {
    color: var(--wine);
    font-style: italic;
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    display: flex;
  }

  .intro-grid {
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 3rem;
    display: grid;
  }

  .intro-grid a {
    color: var(--wine);
    font-weight: 500;
    text-decoration: none;
  }

  .intro-grid a:hover {
    text-decoration: underline;
  }

  .listen-card {
    background: var(--cream);
    border: 1px solid var(--sand-deep);
    border-radius: 4px;
    padding: 1.75rem;
  }

  .listen-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0.3em 0 1em;
  }

  .listen-card audio {
    width: 100%;
  }

  .events-teaser h2 {
    margin-bottom: 2rem;
  }

  .empty-state {
    opacity: 0.75;
    margin-bottom: 2.5rem;
  }

  .event-list {
    border-top: 1px solid #241d2b26;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  .event-list li {
    border-bottom: 1px solid #241d2b26;
    grid-template-columns: 140px 1fr auto;
    gap: 1rem;
    padding: 1.1rem 0;
    display: grid;
  }

  .event-date {
    font-family: var(--font-body);
    color: var(--wine);
    font-size: 0.85rem;
  }

  .event-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .event-place {
    color: var(--plum);
    opacity: 0.9;
  }

    .empty-state {
    opacity: 0.75;
  }

  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3rem;
  }

  .news-item {
    grid-template-columns: 280px 1fr;
    gap: 2rem;
    display: grid;
  }

  .news-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 4px;
    aspect-ratio: 4 / 3;
  }

  .news-date {
    font-family: var(--font-mono);
    color: var(--wine);
    font-size: 0.85rem;
    margin: 0 0 0.4em;
  }

  .news-title {
    margin: 0 0 0.5em;
  }

  .news-text {
    margin: 0;
    max-width: 60ch;
    white-space: pre-line;
  }

  @media (width <= 780px) {
    .hero {
      padding-block: 3rem 5rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-image {
      order: -1;
    }
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .event-list li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  @media (width <= 640px) {
    .news-item {
      grid-template-columns: 1fr;
    }
  }
</style>
