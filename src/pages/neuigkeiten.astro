---
import Layout from '../layouts/Layout.astro';
import { sortedNews, formatNewsDate } from '../data/news';

const items = sortedNews();
---

<Layout title="Neuigkeiten">
  <section class="page-hero section-tint">
    <div class="container">
      <div class="eyebrow">Neuigkeiten</div>
      <h1>Aktuelles von Varicanto</h1>
    </div>
  </section>

  <section>
    <div class="container">
      {items.length > 0 ? (
        <ul class="news-list">
          {items.map((item) => (
            <li class="news-item">
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
              <div class="news-body">
                <p class="news-date">{formatNewsDate(item.date)}</p>
                <h2 class="news-title">{item.title}</h2>
                <p class="news-text">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Aktuell gibt es keine Neuigkeiten.</p>
      )}
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: 4rem 3rem;
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-style: italic;
    margin: 0.2em 0 0;
  }

  .empty-state {
    opacity: 0.75;
  }

  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3rem;
  }

  .news-item {
    grid-template-columns: 280px 1fr;
    gap: 2rem;
    display: grid;
  }

  .news-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    aspect-ratio: 4 / 3;
  }

  .news-date {
    font-family: var(--font-mono);
    color: var(--wine);
    font-size: 0.85rem;
    margin: 0 0 0.4em;
  }

  .news-title {
    margin: 0 0 0.5em;
  }

  .news-text {
    margin: 0;
    max-width: 60ch;
    white-space: pre-line;
  }

  @media (width <= 640px) {
    .news-item {
      grid-template-columns: 1fr;
    }
  }
</style>
